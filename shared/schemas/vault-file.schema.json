{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ironkeep.dev/schema/vault-file-v1.json",
  "title": "Ironkeep encrypted vault file v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "fileVersion", "vaultId", "revision", "updatedAt", "writerDeviceId", "kdf", "keyWrap", "payload"],
  "properties": {
    "format": { "const": "ironkeep-vault" },
    "fileVersion": { "const": 1 },
    "vaultId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "revision": { "type": "integer", "minimum": 1 },
    "updatedAt": { "type": "string", "format": "date-time" },
    "writerDeviceId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "kdf": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "salt", "memoryKiB", "iterations", "parallelism"],
      "properties": {
        "algorithm": { "const": "argon2id" },
        "salt": { "$ref": "#/$defs/base64url16" },
        "memoryKiB": { "type": "integer", "minimum": 19456, "maximum": 262144 },
        "iterations": { "type": "integer", "minimum": 2, "maximum": 10 },
        "parallelism": { "type": "integer", "minimum": 1, "maximum": 8 }
      }
    },
    "keyWrap": { "$ref": "#/$defs/blob" },
    "payload": { "$ref": "#/$defs/blob" }
  },
  "$defs": {
    "base64url": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
    "base64url16": { "type": "string", "minLength": 22, "maxLength": 22, "pattern": "^[A-Za-z0-9_-]+$" },
    "base64url12": { "type": "string", "minLength": 16, "maxLength": 16, "pattern": "^[A-Za-z0-9_-]+$" },
    "blob": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "nonce", "ciphertext"],
      "properties": {
        "algorithm": { "const": "aes-256-gcm" },
        "nonce": { "$ref": "#/$defs/base64url12" },
        "ciphertext": { "type": "string", "minLength": 22, "pattern": "^[A-Za-z0-9_-]+$" }
      }
    }
  }
}
