{
  "manifest_version": 3,
  "name": "Ironkeep",
  "version": "0.1.0",
  "description": "Offline-first, zero-knowledge password manager.",
  "action": { "default_popup": "popup.html", "default_title": "Open Ironkeep" },
  "background": { "scripts": ["background.js"], "type": "module" },
  "permissions": ["activeTab", "clipboardWrite", "identity", "scripting", "storage"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "host_permissions": ["https://www.googleapis.com/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "ironkeep@ironkeep.dev",
      "strict_min_version": "128.0"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
