{
  "manifest_version": 3,
  "name": "Ironkeep",
  "version": "0.7.0",
  "description": "Offline-first, zero-knowledge password manager.",
  "icons": {
    "16": "icons/ironkeep-16.png",
    "32": "icons/ironkeep-32.png",
    "48": "icons/ironkeep-48.png",
    "96": "icons/ironkeep-96.png",
    "128": "icons/ironkeep-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Open Ironkeep",
    "default_icon": {
      "16": "icons/ironkeep-16.png",
      "32": "icons/ironkeep-32.png"
    }
  },
  "background": { "scripts": ["background.js"], "type": "module" },
  "permissions": ["activeTab", "clipboardRead", "clipboardWrite", "identity", "idle", "scripting", "storage"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "host_permissions": ["https://www.googleapis.com/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "ironkeep@ironkeep.dev",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
