{
  "manifest_version": 3,
  "name": "Ironkeep",
  "version": "0.9.1",
  "description": "Offline-first, zero-knowledge password manager.",
  "icons": {
    "16": "icons/ironkeep-16.png",
    "32": "icons/ironkeep-32.png",
    "48": "icons/ironkeep-48.png",
    "128": "icons/ironkeep-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Open Ironkeep",
    "default_icon": {
      "16": "icons/ironkeep-16.png",
      "32": "icons/ironkeep-32.png"
    }
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["activeTab", "clipboardRead", "clipboardWrite", "identity", "idle", "offscreen", "scripting", "storage"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "host_permissions": ["https://www.googleapis.com/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "oauth2": {
    "client_id": "REPLACE_WITH_CHROMIUM_OAUTH_CLIENT_ID.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/drive.appdata"]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
